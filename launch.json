{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Ollama Agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OLLAMA_MODEL": "llama3.2:latest",
                "OLLAMA_HOST": "http://localhost:11434"
            }
        }
    ]
}